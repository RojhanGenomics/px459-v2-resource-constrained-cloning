title: "PX459-v2 gRNA Cloning Under Resource Constraints"
authors:
  - family-names: Rojhannezhad
    given-names: Mahdieh
    orcid: "https://orcid.org/0009-0009-2427-718X"
version: "1.0.0"
date-released: "2026-08-24"
